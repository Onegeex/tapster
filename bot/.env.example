# Tapster reporter bot configuration. Copy to .env and edit.

# The deployed realm (deploy.sh prints it).
TAPSTER_REALM=gno.land/r/g1youraddress/tapster/v0

# gnokey key names to report with, comma-separated. Each must have staked.
REPORTER_KEYS=tapster-admin
# Password of those keys (empty if you made them without one).
KEY_PASSWORD=

# Network.
CHAIN_ID=onyx-1
RPC=https://rpc.onyx.testnets.gno.land:443
PAIRS=GNOT-USD,BTC-USD,ETH-USD,XAU-USD

# Skip a round if exchanges disagree by more than this (basis points).
MAX_SOURCE_SPREAD_BPS=200

# Path to gnokey if it is not on PATH, and its key directory if not default.
GNOKEY=
GNOKEY_HOME=

# Demo only: make one key report a price CHAOS_BPS too high to show slashing.
CHAOS_KEY=
CHAOS_BPS=3000
